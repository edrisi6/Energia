# ─────────────────────────────────────────────────────────────
# Deployment configuration for docker-compose.
# Copy to ".env" and fill in real values. NEVER commit the real .env.
# ─────────────────────────────────────────────────────────────

# --- Domain / HTTPS ---
# Your domain (DNS must point to this server). Caddy gets HTTPS automatically.
# Leave as ":80" to serve plain HTTP locally for testing.
DOMAIN=:80

# --- PostgreSQL ---
PGUSER=fleet
PGPASSWORD=change-me-to-a-strong-password
PGDATABASE=fleet

# --- Auth / security ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=12h
BCRYPT_ROUNDS=12
MAX_FAILED_ATTEMPTS=5
LOCKOUT_MINUTES=15

# Allowed browser origin(s) for the API. "*" is fine since the app is served
# from the same domain via Caddy.
APP_ORIGIN=*

# --- Optional: AI "scan from photo" feature (off unless a key is set) ---
# Add an Anthropic API key (https://console.anthropic.com) to let Owners/
# Managers scan a VIN/rego/spec photo and auto-fill fields. Leave blank to keep
# it off — free on-device scanning still works. Set AI_MODEL=claude-haiku-4-5
# for the lowest cost per scan.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-4-8

# --- First owner account (created on first boot; PIN is hashed immediately) ---
OWNER_NAME=Fleet Owner
OWNER_USERNAME=owner
OWNER_PIN=123456
