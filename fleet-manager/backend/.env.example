# ─────────────────────────────────────────────────────────────
# Vehicle Fleet Manager — backend environment configuration
# Copy this file to ".env" and fill in real values.
# NEVER commit your real .env file. NEVER store PINs in plain text
# anywhere except this seed step, which immediately hashes them.
# ─────────────────────────────────────────────────────────────

# Which database to use: "sqlite" (easy local dev) or "postgres" (production)
DB_CLIENT=sqlite

# --- SQLite settings (used when DB_CLIENT=sqlite) ---
# Path to the local database file. Relative paths are fine.
SQLITE_FILE=./data/fleet.sqlite

# --- PostgreSQL settings (used when DB_CLIENT=postgres) ---
PGHOST=localhost
PGPORT=5432
PGUSER=fleet
PGPASSWORD=change-me
PGDATABASE=fleet

# --- HTTP server ---
PORT=4000
# Comma-separated list of allowed frontend origins for CORS.
CORS_ORIGIN=http://localhost:5173

# --- Authentication / security ---
# Secret used to sign JWT session tokens. Use a long random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
# How long a login session token stays valid.
JWT_EXPIRES_IN=12h

# bcrypt cost factor for hashing PINs (higher = slower = more secure).
BCRYPT_ROUNDS=12

# --- Optional: AI "scan from photo" feature (off unless a key is set) ---
# Add an Anthropic API key to let Owners/Managers scan a VIN/rego/spec photo and
# auto-fill fields. Leave blank to keep it off (free on-device scanning still
# works). Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
# Model used for scans. Default is the most accurate; for the lowest cost per
# scan set this to claude-haiku-4-5.
AI_MODEL=claude-opus-4-8

# Account lockout policy.
MAX_FAILED_ATTEMPTS=5
# How long (in minutes) an account stays locked after too many failures.
LOCKOUT_MINUTES=15

# --- First owner account (created by `npm run seed`) ---
# This is the only place a PIN is written; the seed hashes it immediately.
# Change these before seeding, then change the PIN again in-app after first login.
OWNER_NAME=Fleet Owner
OWNER_USERNAME=owner
OWNER_PIN=123456
