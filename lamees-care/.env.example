# Generate these once with: npm run generate-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=your@email.com

# Timezone for slot scheduling — must match the family's location
TZ=Australia/Melbourne

# Port (Railway/Render set this automatically)
PORT=3000

# Optional: path for the SQLite database file
# DB_PATH=./lamees.db
